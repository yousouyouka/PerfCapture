    { "id": "perf.minFps", "module": "perf", "label": "metric.minFps", "nameZh": "最低帧率", "nameEn": "Minimum FPS", "nameJa": "最低 FPS", "unit": "FPS", "stat": "min", "src": "presentmon", "tiers": ["standard", "pro"], "status": "ok" },
    { "id": "perf.maxFps", "module": "perf", "label": "metric.maxFps", "nameZh": "最高帧率", "nameEn": "Maximum FPS", "nameJa": "最高 FPS", "unit": "FPS", "stat": "max", "src": "presentmon", "tiers": ["standard", "pro"], "status": "ok" },
    { "id": "perf.avgFt", "module": "perf", "label": "metric.avgFrametime", "nameZh": "平均帧时间", "nameEn": "Average frame time", "nameJa": "平均フレーム時間", "unit": "ms", "stat": "avg", "src": "presentmon", "tiers": ["quick", "standard", "pro"], "status": "ok" },
    { "id": "perf.p95Ft", "module": "perf", "label": "metric.p95Frametime", "nameZh": "P95 帧时间", "nameEn": "P95 frame time", "nameJa": "P95 フレーム時間", "unit": "ms", "stat": "p95", "src": "presentmon", "tiers": ["quick", "standard", "pro"], "status": "ok" },
    { "id": "perf.p99Ft", "module": "perf", "label": "metric.p99Frametime", "nameZh": "P99 帧时间", "nameEn": "P99 frame time", "nameJa": "P99 フレーム時間", "unit": "ms", "stat": "p99", "src": "presentmon", "tiers": ["standard", "pro"], "status": "ok" },
