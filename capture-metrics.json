    { "id": "perf.displayLatency", "opt": "latency", "module": "perf", "label": "metric.displayLatency", "nameZh": "上屏延迟", "nameEn": "Display latency", "nameJa": "表示遅延", "unit": "ms", "stat": "avg", "src": "presentmon", "tiers": ["standard", "pro"], "status": "ok" },
