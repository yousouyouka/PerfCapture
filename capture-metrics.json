  "reasons": {
    "na.cpuTemp": {
      "zh": "CPU 温度需要内核级传感器驱动（LibreHardwareMonitor 那一类）才能读。本项目坚持零注入、不捆绑驱动，避免触发反作弊与蓝屏风险，所以本版不提供；不是采不到帧，而是我们不引入这类组件。",
      "en": "CPU temperature needs a kernel-mode sensor driver (the LibreHardwareMonitor class of tools). This project deliberately ships no drivers and no injection, to avoid anti-cheat and stability risks, so it is not provided in this version.",
      "ja": "CPU 温度はカーネルモードのセンサードライバ（LibreHardwareMonitor 系）が必要です。本プロジェクトは非注入・ドライバ非同梱の方針（アンチチートと安定性のリスク回避）のため、本版では提供しません。"
    },
    "na.cpuPower": {
      "zh": "CPU 功耗同样来自传感器驱动（RAPL／主板 EC）。不捆绑驱动就读不到，因此标为暂不可用，绝不用估算值冒充。",
      "en": "CPU power also comes from a sensor driver (RAPL / board EC). Without bundling a driver it cannot be read, so it stays unavailable instead of being estimated.",
      "ja": "CPU 消費電力もセンサードライバ（RAPL／マザーボード EC）由来です。ドライバを同梱しないため取得できず、推定値で代用はしません。"
    },
    "na.cpuThrottle": {
      "zh": "CPU 降频状态要靠温度与功耗数据判断，而这两项本版拿不到；只看频率与占用推算会误报，所以不猜，标为暂不可用。",
      "en": "CPU throttling can only be judged from temperature and power, which this version cannot read. Inferring from clock and usage alone would produce false positives, so it is left unavailable rather than guessed.",
      "ja": "CPU スロットリングは温度と消費電力から判断しますが、本版では取得できません。周波数と使用率だけからの推測は誤判定になるため、推測せず未対応としています。"
    },
    "na.gpuHotspot": {
      "zh": "GPU 热点温度要 NVAPI 的逐传感器读取，nvidia-smi 只给整体温度。本版不引入 NVAPI 组件，所以标为暂不可用。",
      "en": "GPU hotspot temperature requires per-sensor reads through NVAPI; nvidia-smi only exposes the overall temperature. NVAPI is not bundled in this version.",
      "ja": "GPU ホットスポット温度は NVAPI のセンサー単位取得が必要で、nvidia-smi は全体温度のみです。本版は NVAPI を同梱しないため未対応です。"
    },
    "na.sharedVram": {
      "zh": "共享 GPU 内存要看 Windows 的 GPU Adapter Memory 计数器，部分驱动／系统版本不提供该实例。取不到时按「暂不可用」处理，不用 0 或估算替代。",
      "en": "Shared GPU memory relies on the Windows GPU Adapter Memory counters, which some driver/OS versions do not expose. When unavailable it is reported as such, never as zero or an estimate.",
      "ja": "共有 GPU メモリは Windows の GPU Adapter Memory カウンターに依存し、ドライバ／OS によっては公開されません。取得できない場合は未対応として扱い、0 や推定値では置き換えません。"
    },
    "na.renderQueue": {
      "zh": "渲染队列深度属于引擎／驱动内部状态，PresentMon 不对外报告。要做只能在游戏侧插桩，那违反零注入原则，所以暂不可用。",
      "en": "Render queue depth is internal engine/driver state and is not reported by PresentMon. Measuring it would require instrumenting the game, which breaks the zero-injection rule.",
      "ja": "レンダーキューの深さはエンジン／ドライバ内部の状態で、PresentMon は報告しません。計測にはゲーム側の計装が必要で、非注入の原則に反します。"
    },
    "na.gamePreset": {
      "zh": "游戏内的画质档位只存在于游戏自己的配置文件里，格式随厂商与版本变化，第三方无法可靠读取。所以只做「这项技术是否启用」（看 DLL 是否加载），档位请以游戏内显示为准。",
      "en": "In-game presets live only in the game's own config files, whose format changes per vendor and version. We therefore report only whether a technique is active (by checking loaded DLLs); read the actual preset from the game's menu.",
      "ja": "ゲーム内プリセットは各ゲームの設定ファイルにのみ存在し、形式はベンダーとバージョンで変わります。そのため「その技術が有効か（DLL のロード有無）」のみを扱い、プリセットはゲーム内表示を正とします。"
    },
    "na.vramType": {
      "zh": "显存代数（GDDR6/6X/7）无法从 nvidia-smi 或 WMI 可靠读取。按型号查表并不可靠（同名不同版本会用不同显存），所以标为暂不可用，不用猜测值。",
      "en": "The VRAM generation (GDDR6/6X/7) cannot be read reliably from nvidia-smi or WMI, and model-name lookup is unreliable (same name, different memory revisions). It stays unavailable rather than guessed.",
      "ja": "VRAM 規格（GDDR6/6X/7）は nvidia-smi や WMI から確実に取得できず、型番からの推定も不確実（同名でも改版あり）です。推測せず未対応としています。"
    }
  }
}
