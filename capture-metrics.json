    { "id": "perf.p1Low", "module": "perf", "label": "metric.p1low", "nameZh": "1% 低帧率", "nameEn": "1% Low FPS", "nameJa": "1% Low FPS", "unit": "FPS", "stat": "low", "src": "presentmon", "tiers": ["quick", "standard", "pro"], "status": "ok" },
