{
  "schemaVersion": 1,
  "note": "指标字典 = 唯一事实来源。modules 是报告板块顺序；metrics 是全部指标（含暂不可用）。status='ok' 表示本版可采；status='na' 表示本版暂不可用，reason 指向 reasons 里的三语原因（报告与详细说明都必须显示原因，绝不填 0）。label 是 i18n 键，nameZh/nameEn/nameJa 是兜底显示名。tiers 是所属档位（quick/standard/pro）。src 说明数据来源：presentmon=逐帧 CSV、nvsmi=nvidia-smi、pdh=Windows 性能计数器、wmi=系统接口、vendorwmi=厂商固件通道（只读 ACPI-WMI）、winevent=Windows 事件日志、derived=由前述推导。",
  "modules": [
    { "id": "perf", "label": "metric.module.perf", "nameZh": "游戏性能表现", "nameEn": "Game performance", "nameJa": "ゲーム性能",
      "descZh": "帧率水平与稳定性：平均帧率、1% / 0.1% 低帧率、帧时间分布、卡顿次数与时长、上屏延迟。回答「流不流畅、稳不稳、卡不卡」。",
      "descEn": "Frame rate and steadiness: average FPS, 1% / 0.1% low, frame-time distribution, stutter count and duration, display latency. Answers smooth, steady and stutter-free.",
      "descJa": "フレームレートの水準と安定性：平均 FPS、1% / 0.1% 低フレームレート、フレーム時間の分布、スタッターの回数と時間、表示遅延。「滑らかか・安定か・カクつくか」に答えます。" },
    { "id": "cpu", "label": "metric.module.cpu", "nameZh": "CPU 运行状态", "nameEn": "CPU", "nameJa": "CPU 状態",
      "descZh": "处理器侧的执行情况：总占用与单核峰值、游戏进程自身的 CPU 占用、当前频率。看它会不会在交付帧的时候掉队。",
      "descEn": "How the processor keeps up: total and per-core usage, the game process CPU share, and current clock. Tells whether the CPU falls behind when delivering frames.",
      "descJa": "CPU 側の実行状況：全体と単核の使用率、ゲームプロセス自身の CPU 使用率、現在のクロック。フレーム供給で遅れを取っていないかを見ます。" },
    { "id": "gpu", "label": "metric.module.gpu", "nameZh": "GPU 运行状态", "nameEn": "GPU", "nameJa": "GPU 状態",
      "descZh": "显卡的实际负载：占用、核心与显存频率、功耗、温度、风扇、PCIe 链路，以及降频原因（功耗墙 / 温度墙 / 硬件降频）。",
      "descEn": "What the GPU is actually doing: usage, core and memory clocks, power, temperature, fan, PCIe link, plus throttle reasons (power / thermal / hardware).",
      "descJa": "GPU の実際の負荷：使用率、コアとメモリのクロック、消費電力、温度、ファン、PCIe リンク、そしてスロットリング理由（電力制限・温度制限・ハードウェア制限）。" },
    { "id": "memory", "label": "metric.module.memory", "nameZh": "内存与显存", "nameEn": "Memory", "nameJa": "メモリ",
      "descZh": "游戏进程占用的内存与显存、整机内存与显存的使用率、剩余内存与提交量。够不够用、会不会因为换页掉帧。",
      "descEn": "Memory and VRAM used by the game, machine-wide memory and VRAM utilisation, free memory and commit. Whether there is enough headroom or paging causes drops.",
      "descJa": "ゲームが使うメモリと VRAM、PC 全体のメモリと VRAM 使用率、空きメモリとコミット量。足りているか、ページングで落ちていないか。" },
    { "id": "thermal", "label": "metric.module.thermal", "nameZh": "功耗与温控", "nameEn": "Power & thermals", "nameJa": "電力と温度",
      "descZh": "功耗与温度有没有触到限制：平均 / 峰值功耗、温度限制与功耗限制是否真的触发、温度降频占比。",
      "descEn": "Whether power and temperature hit their limits: average and peak power, whether thermal or power limits actually triggered, and how much time was spent thermally throttled.",
      "descJa": "電力と温度が上限に当たっているか：平均・ピーク消費電力、温度制限・電力制限が実際に発動したか、温度によるスロットリングの割合。" },
    { "id": "bottleneck", "label": "metric.module.bottleneck", "nameZh": "渲染瓶颈分析", "nameEn": "Bottleneck", "nameJa": "ボトルネック",
      "descZh": "同一份逐帧数据算出的瓶颈依据：GPU 忙碌时间占比、CPU 帧处理时间、GPU 渲染与等待时间、帧生成状态。结论与依据一起给，不单说一句「显卡瓶颈」。",
      "descEn": "The evidence behind the bottleneck verdict, from the same per-frame data: GPU busy share, CPU frame time, GPU render and wait time, frame generation state. The verdict always ships with its evidence.",
      "descJa": "同じフレーム単位データから出すボトルネックの根拠：GPU ビジー率、CPU のフレーム処理時間、GPU の描画時間と待ち時間、フレーム生成の状態。結論は必ず根拠とセットで示します。" },
    { "id": "environment", "label": "metric.module.environment", "nameZh": "测试环境", "nameEn": "Test environment", "nameJa": "テスト環境",
      "descZh": "这次采集的现场条件：处理器与显卡型号、内存代数、分辨率与窗口模式、呈现后端与模式、超分与帧生成是否加载、前台占比。换环境后这些数不可直接横比。",
      "descEn": "The conditions of this capture: CPU and GPU model, memory type, resolution and window mode, present API and mode, which upscalers and frame generation were loaded, foreground ratio. Numbers are not directly comparable across environments.",
      "descJa": "今回の計測条件：CPU と GPU の型番、メモリ規格、解像度とウィンドウモード、提示 API とモード、超解像とフレーム生成の読み込み状況、前面率。環境が変わると数値をそのまま比較できません。" }
  ],
  "metrics": [
