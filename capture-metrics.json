    { "id": "perf.pcLatency", "opt": "latency", "module": "perf", "label": "metric.pcLatency", "nameZh": "PC 延迟（估算）", "nameEn": "PC latency (estimated)", "nameJa": "PC レイテンシ（推定）", "unit": "ms", "stat": "est", "src": "derived", "tiers": ["standard", "pro"], "status": "ok" },
